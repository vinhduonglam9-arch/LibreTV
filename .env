# LibreTV 配置文件
PASSWORD=libretv

# 允许在 HTTP 环境（局域网 / 手机 App / IP 访问）下正常保存会话 Cookie
COOKIE_SECURE=false

# 代理上游超时与重试
REQUEST_TIMEOUT=8000
MAX_RETRIES=1

# 调试模式
DEBUG=false

# 预置高质量点播采集源（全部实测 200/206 且支持 CORS 直接播放）
