{
  "name": "libretv",
  "version": "2.0.0",
  "productName": "LibreTV",
  "main": "desktop/main.js",
  "author": "LibreTV",
  "description": "免费在线视频搜索与观看平台（Next.js 重构版）",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "next dev -p 8080",
    "build": "next build",
    "start": "next start -p 8080",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:win": "electron-builder --win nsis --publish never",
    "build:win:dir": "electron-builder --win dir"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-virtual": "^3.14.12",
    "artplayer": "^5.2.3",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "hls.js": "^1.5.17",
    "mpegts.js": "^1.8.2",
    "mux.js": "^6.3.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "org.libretv.desktop",
    "productName": "LibreTV",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": false,
    "files": [
      "desktop/**/*",
      ".next/**/*",
      "public/**/*",
      "package.json",
      ".env",
      "node_modules/**/*"
    ],
    "win": {
      "executableName": "LibreTV",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LibreTV",
      "artifactName": "LibreTV-${version}-Setup.${ext}"
    }
  }
}
